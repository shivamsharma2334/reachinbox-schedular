generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum DeliveryAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  googleId         String?           @unique
  name             String
  email            String            @unique
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senders          Sender[]
  campaigns        EmailCampaign[]
  emails           ScheduledEmail[]
  slackIntegration SlackIntegration?
}

model Sender {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @db.Uuid
  name                  String
  email                 String
  smtpHost              String
  smtpPort              Int      @default(587)
  smtpSecure            Boolean  @default(false)
  smtpUsernameEncrypted String
  smtpPasswordEncrypted String
  isActive              Boolean  @default(true)
  minDelayMs            Int      @default(2000)
  hourlyLimit           Int      @default(100)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns EmailCampaign[]
  emails    ScheduledEmail[]

  @@unique([userId, email])
  @@index([userId, isActive])
}

model EmailCampaign {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  senderId             String   @db.Uuid
  name                 String
  subject              String
  body                 String   @db.Text
  startAt              DateTime
  delayBetweenEmailsMs Int      @default(2000)
  hourlyLimit          Int      @default(100)
  totalRecipients      Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender           @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emails ScheduledEmail[]

  @@index([userId, createdAt])
}

model ScheduledEmail {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @db.Uuid
  senderId          String      @db.Uuid
  campaignId        String?     @db.Uuid
  recipient         String
  subject           String
  body              String      @db.Text
  scheduledAt       DateTime
  sentAt            DateTime?
  status            EmailStatus @default(SCHEDULED)
  idempotencyKey    String      @unique
  queueJobId        String?     @unique
  providerMessageId String?
  attemptCount      Int         @default(0)
  lastError         String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender   Sender                 @relation(fields: [senderId], references: [id], onDelete: Restrict)
  campaign EmailCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  attempts EmailDeliveryAttempt[]

  @@index([status, scheduledAt])
  @@index([senderId, createdAt])
  @@index([userId, createdAt])
}

model EmailDeliveryAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  emailId           String                @db.Uuid
  attemptNumber     Int
  status            DeliveryAttemptStatus @default(STARTED)
  startedAt         DateTime              @default(now())
  finishedAt        DateTime?
  providerMessageId String?
  error             String?               @db.Text
  createdAt         DateTime              @default(now())

  email ScheduledEmail @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, attemptNumber])
  @@index([emailId, createdAt])
}

model SlackIntegration {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  teamId            String
  teamName          String
  botUserId         String?
  botTokenEncrypted String
  scopes            String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
